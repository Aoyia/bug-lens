{
  "name": "bug-lens",
  "version": "0.7.34",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/build.mjs --e2e && playwright test --headed",
    "test:e2e:fast": "node scripts/build.mjs --e2e && playwright test --headed --grep-invert \"@slow\"",
    "test:e2e:smoke": "node scripts/build.mjs --e2e && playwright test e2e/smoke.spec.ts --headed",
    "test:e2e:stress": "node scripts/build.mjs --e2e && playwright test e2e/burst-stress.spec.ts --headed",
    "build:fixture-apps": "node scripts/build-fixture-apps.mjs",
    "verify:fixture-apps": "node scripts/verify-fixture-apps.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.e2e.json",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-dom18": "npm:react-dom@18.3.1",
    "react18": "npm:react@18.3.1",
    "tsx": "^4.23.5",
    "typescript": "^5.8.0",
    "vue": "^3.5.42",
    "vue2": "npm:vue@2.7.16",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@jridgewell/trace-mapping": "^0.3.31",
    "fflate": "^0.8.3",
    "fix-webm-duration": "^1.0.6",
    "mp4-muxer": "^5.2.2",
    "preact": "^10.29.7"
  }
}
