{
  "name": "bug-lens",
  "version": "0.7.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "package": "node scripts/package.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node scripts/build.mjs --e2e && playwright test --headed",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.e2e.json",
    "typecheck:e2e": "tsc --project tsconfig.e2e.json",
    "prepare": "husky",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/chrome": "^0.2.2",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "preact-render-to-string": "^6.7.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "fix-webm-duration": "^1.0.6",
    "preact": "^10.29.7"
  }
}
