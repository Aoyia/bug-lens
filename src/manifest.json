{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "zh_CN",
  "version": "0.7.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "125",
  "action": {
    "default_popup": "popup.html",
    "default_title": "__MSG_actionDefaultTitle__",
    "default_icon": {
      "16": "icons/icon_idle_16.png",
      "32": "icons/icon_idle_32.png",
      "48": "icons/icon_idle_48.png",
      "128": "icons/icon_idle_128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y",
        "linux": "Ctrl+Shift+Y",
        "windows": "Ctrl+Shift+Y"
      }
    },
    "start-recording": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Option+R",
        "linux": "Alt+R",
        "windows": "Alt+R"
      },
      "description": "__MSG_commandStartRecordingDescription__"
    },
    "take-screenshot": {
      "suggested_key": {
        "default": "Alt+X",
        "mac": "Option+X",
        "linux": "Alt+X",
        "windows": "Alt+X"
      },
      "description": "__MSG_commandTakeScreenshotDescription__"
    }
  },
  "icons": {
    "16": "icons/icon_idle_16.png",
    "32": "icons/icon_idle_32.png",
    "48": "icons/icon_idle_48.png",
    "128": "icons/icon_idle_128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": [
    "activeTab",
    "tabs",
    "alarms",
    "clipboardWrite",
    "debugger",
    "downloads",
    "offscreen",
    "scripting",
    "storage",
    "tabCapture",
    "unlimitedStorage",
    "webNavigation"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["vue-devtools-hook-inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "preview.html",
        "offscreen.html",
        "permission.html",
        "_locales/*",
        "_locales/*/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
