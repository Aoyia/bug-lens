{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "default_locale": "zh_CN",
  "version": "0.4.0",
  "description": "__MSG_extensionDescription__",
  "minimum_chrome_version": "125",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bug Lens",
    "default_icon": {
      "16": "icons/icon_idle_16.png",
      "32": "icons/icon_idle_32.png",
      "48": "icons/icon_idle_48.png",
      "128": "icons/icon_idle_128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y",
        "linux": "Ctrl+Shift+Y",
        "windows": "Ctrl+Shift+Y"
      }
    }
  },
  "icons": {
    "16": "icons/icon_idle_16.png",
    "32": "icons/icon_idle_32.png",
    "48": "icons/icon_idle_48.png",
    "128": "icons/icon_idle_128.png"
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "tabs", "alarms", "debugger", "downloads", "offscreen", "scripting", "storage", "tabCapture", "unlimitedStorage", "webNavigation"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [],
  "host_permissions": [],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" },
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "preview.html", "offscreen.html", "permission.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
