---
import type { SiteCopy } from "../data/i18n";
import { SKILL_INSTALL_CMD } from "../data/site";
import CopyButton from "./CopyButton.astro";
import PerfBenchDeck from "./PerfBenchDeck.astro";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
---

<section id="agent-skill" class="section section-alt">
  <div class="grid">
    <div class="skill-showcase">
      <div class="skill-info reveal reveal-curtain">
        <div class="section-eyebrow">{copy.skillEyebrow}</div>
        <h2 class="section-title">{copy.skillTitle}</h2>
        <p class="skill-lead">{copy.skillDesc}</p>
        <ul class="skill-points">
          {copy.skillPoints.map((point) => <li>{point}</li>)}
        </ul>
      </div>

      <div class="skill-terminal-card reveal" style="--reveal-delay: 90ms">
        <div class="skill-card-head">
          <span class="skill-card-badge">{copy.skillCardBadge}</span>
          <span class="skill-card-platforms">{copy.skillCardPlatforms}</span>
        </div>

        <div class="skill-cmd-group">
          <div class="skill-cmd-label">{copy.skillInstallLabel}</div>
          <div class="cli-capsule">
            <code class="cli-code">
              <span class="cli-prefix">$</span>
              <span>{SKILL_INSTALL_CMD}</span>
            </code>
            <CopyButton
              variant="cli"
              label={copy.cliCopy}
              copiedLabel={copy.cliCopied}
              copyText={SKILL_INSTALL_CMD}
            />
          </div>
        </div>

        <p class="skill-auto-note">{copy.skillAutoInstallNote}</p>
      </div>
    </div>

    <PerfBenchDeck copy={copy} />
  </div>
</section>
