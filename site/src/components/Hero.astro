---
import type { SiteCopy } from "../data/i18n";
import { LATEST_RELEASE } from "../data/releases";
import {
  CHROME_STORE_URL,
  EDGE_STORE_URL,
  GITHUB_RELEASES_LATEST_URL,
  GITHUB_REPO_URL,
  IMAGE_DIMENSIONS,
  withBase,
} from "../data/site";

interface Props {
  copy: SiteCopy;
}

const { copy } = Astro.props;
const versionTag = `v${LATEST_RELEASE.version}`;
const demoPoster = withBase("/assets/demo/demo-poster.jpg");
const demoMp4 = withBase("/assets/demo/bug-lens-demo.mp4");
const demoWebm = withBase("/assets/demo/bug-lens-demo.webm");
---

<section class="hero-section">
  <div class="grid">
    <div class="hero">
      <a
        id="heroVersionPill"
        href="#changelog"
        class="version-pill"
        data-open-changelog
      >
        <span id="heroVersionTag" class="version-pill-tag">{versionTag}</span>
        <span id="heroVersionText" class="version-pill-text">
          {`${versionTag} ${copy.heroVersionBadgePrefix}`}
        </span>
        <span class="version-pill-arrow" aria-hidden="true">→</span>
      </a>

      <h1 set:html={copy.heroTitleHtml} />

      <p class="hero-lead">{copy.heroSub}</p>

      <div class="eff-compare">
        <div class="eff-card old">
          <span class="eff-label">{copy.effOldLabel}</span>
          <span class="eff-time">{copy.effOldTime}</span>
          <span class="eff-desc">{copy.effOldDesc}</span>
        </div>
        <div class="eff-card new">
          <span class="eff-label">{copy.effNewLabel}</span>
          <span class="eff-time">{copy.effNewTime}</span>
          <span class="eff-desc">{copy.effNewDesc}</span>
        </div>
      </div>

      <div class="cta-row">
        <a
          id="primaryInstallBtn"
          href={CHROME_STORE_URL}
          data-edge-url={EDGE_STORE_URL}
          data-edge-label={copy.ctaStoreEdge}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary"
        >
          <span id="installIconChrome" class="install-btn-icon">
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="10"></circle>
              <circle cx="12" cy="12" r="4"></circle>
              <line x1="21.17" y1="8" x2="12" y2="8"></line>
              <line x1="3.95" y1="6.06" x2="8.54" y2="14"></line>
              <line x1="10.88" y1="21.94" x2="15.46" y2="14"></line>
            </svg>
          </span>
          <span id="installIconEdge" class="install-btn-icon" hidden>
            <svg
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path
                d="M 16.2 19.9 A 9 9 0 1 1 21 12 H 9 A 3.5 3.5 0 0 0 12.5 15.5"
              ></path>
            </svg>
          </span>
          <span id="primaryInstallLabel">{copy.ctaStore}</span>
        </a>
        <a
          href={GITHUB_REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
        >
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
            ></path>
          </svg>
          <span>{copy.ctaSource}</span>
        </a>
      </div>

      <div class="hero-sub-actions">
        <p class="hero-alt-channels">
          <a
            id="altStoreLink"
            href={EDGE_STORE_URL}
            data-chrome-url={CHROME_STORE_URL}
            data-chrome-label={copy.altChromeStore}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-channel-link"
          >
            {copy.altEdgeStore}
          </a>
          <span class="hero-alt-sep" aria-hidden="true">·</span>
          <a
            href={GITHUB_RELEASES_LATEST_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="hero-channel-link"
          >
            {copy.altOfflineZip}
          </a>
        </p>
      </div>

      <div class="demo-player-wrap reveal">
        <div class="window-topbar">
          <div class="tl-dots" aria-hidden="true">
            <span class="tl-dot r"></span>
            <span class="tl-dot y"></span>
            <span class="tl-dot g"></span>
          </div>
          <span class="demo-player-tag">{copy.demoPlayerTag}</span>
        </div>
        <div class="demo-video-box">
          <video
            id="heroDemoVideo"
            width={IMAGE_DIMENSIONS.demoPoster.width}
            height={IMAGE_DIMENSIONS.demoPoster.height}
            poster={demoPoster}
            autoplay
            loop
            muted
            playsinline
            controls
            preload="metadata"
          >
            <source src={demoMp4} type="video/mp4" />
            <source src={demoWebm} type="video/webm" />
            <span>{copy.demoFallback}</span>
          </video>
        </div>
      </div>
    </div>
  </div>
</section>
