---
import type { SiteCopy } from "../data/i18n";
import { LATEST_RELEASE, OLDEST_RELEASE } from "../data/releases";
import type { Locale } from "../data/site";

interface Props {
  locale: Locale;
  copy: SiteCopy;
}

const { locale, copy } = Astro.props;
const highlights = LATEST_RELEASE.highlights[locale] || [];
const rangeLabel = `${copy.changelogViewAllPrefix} (v${OLDEST_RELEASE.version} ~ v${LATEST_RELEASE.version}) →`;
---

<section id="changelog" class="section">
  <div class="grid">
    <div class="section-eyebrow reveal reveal-curtain">
      {copy.changelogEyebrow}
    </div>
    <div
      class="changelog-summary-header reveal reveal-curtain"
      style="--reveal-delay: 50ms"
    >
      <div class="changelog-summary-desc-wrap">
        <h2 class="section-title">{copy.changelogTitle}</h2>
        <p class="section-desc">{copy.changelogDesc}</p>
      </div>
      <button
        id="changelogViewAllBtn"
        type="button"
        class="changelog-open-drawer-btn"
        data-open-changelog
      >
        {rangeLabel}
      </button>
    </div>

    <div
      id="changelogSummaryCard"
      class="changelog-summary-card reveal"
      style="--reveal-delay: 100ms"
    >
      <div class="changelog-header">
        <div class="changelog-meta">
          <span class="changelog-ver">{`v${LATEST_RELEASE.version}`}</span>
          <span class="changelog-tag">{copy.tagLatest}</span>
          <span class="changelog-date">{LATEST_RELEASE.date}</span>
        </div>
        <button
          type="button"
          class="changelog-summary-more-btn"
          data-open-changelog
        >
          {copy.changelogHistoryText}
        </button>
      </div>
      <div class="changelog-content">
        {
          highlights.map((item) => (
            <div class="changelog-feature">
              <strong>{item.title}</strong>
              <span>{` ${item.desc}`}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
